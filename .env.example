# ================================
# GX Gestión Técnica - Variables de Entorno
# ================================

# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/inco_gestion?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-un-secret-muy-largo-y-seguro-aqui-con-openssl-rand-base64-32"

# JWT
JWT_SECRET="otro-secret-muy-seguro-para-jwt"
JWT_EXPIRES_IN="7d"

# OpenAI (módulo diagnóstico IA)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# Microsoft (integración M365)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""

# Email (Nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu-correo@empresa.com"
SMTP_PASSWORD="tu-contraseña-de-aplicacion"
EMAIL_FROM="INCO Soporte <soporte@tuempresa.com>"

# Upload de archivos
UPLOAD_MAX_SIZE="10485760"
UPLOAD_DIR="./public/uploads"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="GX Gestión Técnica"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Rate limiting
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW="900000"

# Ambiente
NODE_ENV="development"
